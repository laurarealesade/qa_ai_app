# Ruta local donde OneDrive sincroniza los adjuntos de ServiceNow
# Outlook guardará los adjuntos aquí automáticamente (via regla de Outlook)
# Windows ejemplo:
INCOMING_FOLDER=C:\Users\TuNombre\OneDrive\servicenow-reports\incoming
PROCESSED_FOLDER=C:\Users\TuNombre\OneDrive\servicenow-reports\processed

# Archivo Excel de salida que Power BI leerá (también en OneDrive sincronizado)
OUTPUT_FILE=C:\Users\TuNombre\OneDrive\servicenow-reports\dashboard_data.xlsx

# Con qué frecuencia revisar la carpeta (en minutos)
POLL_INTERVAL_MINUTES=60

# Power BI auto-refresh (OPCIONAL — déjalo vacío si usas el refresh programado de Power BI Service)
# Solo necesario si quieres que el refresh ocurra exactamente cuando llega el archivo
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
